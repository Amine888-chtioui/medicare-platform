# ==============================================================================
# MediCare Platform — Docker Compose Environment Configuration
# Copy this file to .env and adjust variables before running: docker compose up -d
# ==============================================================================

# Database settings
DB_NAME=medicare_db
DB_USER=medicare_user
DB_PASSWORD=change_this_mysql_password_in_prod
DB_ROOT_PASSWORD=change_this_root_password_in_prod

# JWT Secret (MUST be at least 32 characters / 256 bits, random hex or string)
JWT_SECRET=generate_a_64_char_secure_random_hex_key_for_production_use_only

# CORS configuration (Frontend origins allowed to call Backend)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Frontend build arg: URL used by browser to query backend
# For Docker Compose on local machine: http://localhost:8080
# For remote deployment: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
