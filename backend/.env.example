# ====================================================
# MediCare Platform - Backend Environment Variables
# ====================================================

# Port du serveur Spring Boot
SERVER_PORT=8080

# Connexion MySQL
DB_URL=jdbc:mysql://localhost:3306/medicare_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Mode Hibernate DDL (update en dev, validate en prod)
JPA_DDL_AUTO=update

# Origines autorisées CORS (séparées par une virgule)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Sécurité JWT (clé secrète minimale 256 bits en hexa ou base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=28800000
