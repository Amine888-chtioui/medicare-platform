# ====================================================
# MediCare Platform - Frontend environment variables
# Copy to .env.local and fill in the confirmed values.
# Never commit real contact details or secrets.
# ====================================================

# Backend origin. Leave empty for same-origin deployment
# (Vite dev proxy or nginx /api reverse proxy).
VITE_API_BASE_URL=http://localhost:8080

# --- Professional contact details (ONLY confirmed values) ---
# Leave empty until the doctor confirms them. The UI hides them otherwise.
VITE_DOCTOR_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_CLINIC_NAME=
VITE_CLINIC_ADDRESS=
VITE_CLINIC_CITY=
VITE_HOURS_WEEK=
VITE_HOURS_SATURDAY=

# Google Maps embed URL (src attribute) and public "open map" link
VITE_MAP_EMBED_URL=
VITE_MAP_LINK_URL=

# Social profiles (optional)
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
